        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_live" android:shortcutLongLabel="@string/sc_live_long">
        <intent android:action="ru.pocketagent.LIVE"
            android:targetPackage="ru.pocketagent" android:targetClass="ru.pocketagent.MainActivity"/>
    </shortcut>
    <shortcut android:shortcutId="lists" android:enabled="true"
        android:icon="@mipmap/ic_launcher"
