<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/chip"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:textSize="14sp" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginBottom="6dp"
        android:textColor="@color/pa_sub" android:background="@drawable/bg_pill"/>
    <TextView android:id="@+id/text"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxWidth="340dp" android:paddingStart="18dp" android:paddingEnd="18dp"
        android:paddingTop="13dp" android:paddingBottom="13dp" android:textSize="19sp"
        android:textColor="@color/pa_text" android:lineSpacingMultiplier="1.12" android:background="@drawable/bubble_assistant"/>
</LinearLayout>
