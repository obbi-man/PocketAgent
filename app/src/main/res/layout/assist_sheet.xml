<?xml version="1.0" encoding="utf-8"?>
<!-- Окно помощника поверх текущего приложения (как у Gemini): тап по затемнению — закрыть -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrim"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#66000000">
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="@drawable/bg_sheet" android:clickable="true" android:focusable="true"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp">
        <View android:layout_width="40dp" android:layout_height="5dp" android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" android:background="@drawable/bg_handle"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_sparkle"/>
            <TextView android:id="@+id/sheetTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:text="PocketAgent" android:textStyle="bold"
                android:textSize="19sp" android:textColor="@color/pa_text"/>
            <ImageView android:id="@+id/sheetExpand" style="@style/PA.IconBtn" android:src="@drawable/ic_open_full"
                android:contentDescription="Открыть приложение целиком"/>
            <ImageView android:id="@+id/sheetClose" style="@style/PA.IconBtn" android:src="@drawable/ic_close"
                android:contentDescription="Закрыть"/>
        </LinearLayout>
        <ScrollView android:id="@+id/sheetScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/sheetHeard" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textColor="@color/pa_sub" android:paddingBottom="4dp"/>
                <TextView android:id="@+id/sheetAnswer" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="19sp" android:textColor="@color/pa_text" android:lineSpacingExtra="3dp"
                    android:textIsSelectable="true" android:paddingBottom="8dp"/>
            </LinearLayout>
        </ScrollView>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:id="@+id/sheetChips"
                android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleLine="true">
                <com.google.android.material.chip.Chip android:id="@+id/chipRead"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✓ экран прочитан" android:textSize="15sp" android:visibility="gone"
                    android:clickable="false"/>
                <com.google.android.material.chip.Chip android:id="@+id/chipScreen"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📱 Спросить про экран" android:textSize="16sp"/>
                <com.google.android.material.chip.Chip android:id="@+id/chipRetell"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Перескажи экран" android:textSize="16sp" android:visibility="gone"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <TextView android:id="@+id/sheetHint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="@color/pa_sub" android:paddingTop="2dp" android:paddingBottom="6dp"
            android:visibility="gone"/>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:minHeight="62dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="5dp" android:background="@drawable/bg_input">
            <EditText android:id="@+id/sheetInput"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="50dp" android:background="@null" android:paddingStart="14dp" android:paddingEnd="2dp"
                android:hint="Спросите что-нибудь…" android:textColorHint="@color/pa_sub" android:textColor="@color/pa_text"
                android:maxLines="4" android:textSize="18sp" android:imeOptions="actionSend"
                android:inputType="textCapSentences"/>
            <ImageView android:id="@+id/sheetMic" style="@style/PA.IconBtn" android:src="@drawable/ic_mic"
                android:contentDescription="Голосовой ввод"/>
            <ImageView android:id="@+id/sheetSend"
                android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="2dp"
                android:padding="13dp" android:background="@drawable/bg_grad_circle"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_wave" android:clickable="true" android:focusable="true"
                android:contentDescription="Живой режим"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
